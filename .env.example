# Flask session signing and daily-link tokens. Generate one:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SHOLA_SECRET_KEY=change-me

# Public URL used in emails. Must be reachable by volunteers.
SHOLA_SITE_URL=http://localhost:5000

# Gmail SMTP. SHOLA_SMTP_PASSWORD must be a Google App Password
# (Google Account -> Security -> 2-step verification -> App passwords),
# not the account password.
SHOLA_SMTP_HOST=smtp.gmail.com
SHOLA_SMTP_PORT=465
SHOLA_SMTP_USER=you@gmail.com
SHOLA_SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SHOLA_MAIL_FROM_NAME=SHOLA

# Commitment per volunteer.
SHOLA_WORDS_PER_VOLUNTEER=1000
SHOLA_COMMITMENT_DAYS=365

# Optional: Postgres instead of SQLite
# SHOLA_DATABASE_URL=postgresql+psycopg://user:pass@localhost/shola
